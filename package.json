{
  "name": "ryanjensen-dev",
  "version": "1.0.0",
  "scripts": {
    "handouts": "node packages/resume/build.mjs handouts",
    "downloads": "node packages/resume/build.mjs site",
    "dev": "npm run dev -w @ryanjensen/web",
    "build": "npm run downloads && npm run build -w @ryanjensen/web",
    "doctor": "node scripts/doctor.mjs",
    "worktree:link": "node scripts/worktree-link.mjs",
    "check:private": "node scripts/check-private.mjs --all",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
